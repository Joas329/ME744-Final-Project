<?xml version="1.0"?>
<!--
  Gazebo Fortress world for the rig: physics at 1 ms, the room, and the phone camera that films the tags.
  The servo arm itself comes from urdf/servo_arm.urdf.xacro and is spawned into this world by the launch file.
    xacro rig.sdf.xacro fps:=200 rtf:=0.5 showcase:=false > rig.sdf
  fps: camera rate; a divisor of 1000 that fits the 50 ms grid (100, 200, 250).
-->
<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="fps" default="200"/>
  <xacro:arg name="rtf" default="0.5"/>
  <xacro:arg name="showcase" default="false"/>
  <xacro:property name="pivot_z" value="0.35"/>

  <world name="rig">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>$(arg rtf)</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="lamp">
      <cast_shadows>false</cast_shadows>
      <pose>0 -1 1.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 1 -0.4</direction>
    </light>

    <!-- room: floor and a plain backdrop behind the arm -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <visual name="floor">
          <pose>0 0 -0.005 0 0 0</pose>
          <geometry><box><size>1.2 1.2 0.01</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
        <visual name="backdrop">
          <pose>0 0.12 ${pivot_z} 0 0 0</pose>
          <geometry><box><size>0.8 0.01 0.6</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- the phone, 0.55 m in front of the pivot, looking along +y; images on /rig/camera/image -->
    <model name="phone_camera">
      <static>true</static>
      <pose>0 -0.55 ${pivot_z} 0 0 1.570796</pose>
      <link name="link">
        <visual name="phone">
          <pose>-0.005 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.07 0.15</size></box></geometry>
          <material><ambient>0.15 0.15 0.2 1</ambient><diffuse>0.15 0.15 0.2 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>$(arg fps)</update_rate>
          <visualize>false</visualize>
          <topic>rig/camera/image</topic>
          <camera>
            <horizontal_fov>0.9</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5</far></clip>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.004</stddev></noise>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- optional angled camera for pictures (/rig/showcase/image) -->
    <xacro:if value="$(arg showcase)">
      <model name="showcase_camera">
        <static>true</static>
        <pose>0.42 -0.62 ${pivot_z + 0.22} 0 0.32 2.18</pose>
        <link name="link">
          <sensor name="showcase" type="camera">
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <visualize>false</visualize>
            <topic>rig/showcase/image</topic>
            <camera>
              <horizontal_fov>0.8</horizontal_fov>
              <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
              <clip><near>0.05</near><far>10</far></clip>
            </camera>
          </sensor>
        </link>
      </model>
    </xacro:if>
  </world>
</sdf>
